          }
        ]
      ]
    },
    "Window Buffer Memory": {
      "ai_memory": [
        [
          {
            "node": "AI Pricing Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "recommend_price": {
      "ai_tool": [
        [
          {
            "node": "AI Pricing Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "simulate_price": {
      "ai_tool": [
        [
          {
            "node": "AI Pricing Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "search_products": {
      "ai_tool": [
        [
          {
            "node": "AI Pricing Agent",
